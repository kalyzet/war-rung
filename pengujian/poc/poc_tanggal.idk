# PoC 6 - Tanggal: tanggal(), format_tanggal, arti hari_minggu,
# aritmetika tanggal (civil <-> hari epoch), awal minggu Senin,
# rentang bulan untuk laporan.

cetak("== 1. tanggal() ==")
variabel t = tanggal()
cetak(t)
cetak("tahun:", t["tahun"], "bulan:", t["bulan"], "hari:", t["hari"])
cetak("jam:", t["jam"], "menit:", t["menit"], "detik:", t["detik"])
cetak("hari_minggu:", t["hari_minggu"], "hari_tahun:", t["hari_tahun"])

cetak("== 2. format_tanggal ==")
cetak(format_tanggal("%Y-%m-%d"))
cetak(format_tanggal("%Y-%m-%d %H:%M:%S"))
cetak("%u (Min=1..Sab=7):", format_tanggal("%u"), "| %w (Min=0..Sab=6):", format_tanggal("%w"), "| %A:", format_tanggal("%A"))

# --- utilitas aritmetika tanggal (kandidat inti/tanggal.idk) ---------------

fungsi hari_dari_civil(t, b, h) {
    t = ke_bulat(t)
    b = ke_bulat(b)
    h = ke_bulat(h)
    variabel y = t
    jika b <= 2 {
        y = y - 1
    }
    variabel era = (y jika y >= 0 selain y - 399) // 400
    variabel yoe = y - era * 400
    variabel doy = (153 * (b + (-3 jika b > 2 selain 9)) + 2) // 5 + h - 1
    variabel doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    kembalikan era * 146097 + doe - 719468
}

fungsi civil_dari_hari(z) {
    z = ke_bulat(z)
    variabel zz = z + 719468
    variabel era = (zz jika zz >= 0 selain zz - 146096) // 146097
    variabel doe = zz - era * 146097
    variabel yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    variabel y = yoe + era * 400
    variabel doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    variabel mp = (5 * doy + 2) // 153
    variabel h = doy - (153 * mp + 2) // 5 + 1
    variabel b = mp + (3 jika mp < 10 selain -9)
    jika b <= 2 {
        y = y + 1
    }
    kembalikan [y, b, h]
}

fungsi teks_civil(z) {
    variabel c = civil_dari_hari(z)
    variabel teks_bulan = ke_teks(c[1])
    variabel teks_hari = ke_teks(c[2])
    jika panjang(teks_bulan) < 2 { teks_bulan = "0" + teks_bulan }
    jika panjang(teks_hari) < 2 { teks_hari = "0" + teks_hari }
    kembalikan ke_teks(c[0]) + "-" + teks_bulan + "-" + teks_hari
}

# 0 = Senin ... 6 = Minggu (konsisten strftime %u - 1)
fungsi hari_dalam_minggu(z) {
    kembalikan (z + 3) % 7
}

fungsi awal_minggu_senin(z) {
    kembalikan z - hari_dalam_minggu(z)
}

cetak("== 3. round-trip civil <-> hari epoch ==")
pastikan hari_dari_civil(1970, 1, 1) == 0, "epoch 1970-01-01 harus 0"
untuk contoh_tgl dalam [[2026, 11, 4], [2000, 2, 29], [2100, 3, 1], [1999, 12, 31], [1, 1, 1], [2024, 2, 29], [1600, 2, 29]] {
    variabel z = hari_dari_civil(contoh_tgl[0], contoh_tgl[1], contoh_tgl[2])
    variabel balik = civil_dari_hari(z)
    pastikan balik[0] == contoh_tgl[0] dan balik[1] == contoh_tgl[1] dan balik[2] == contoh_tgl[2], "round-trip gagal: " + format("{}-{}-{}", contoh_tgl[0], contoh_tgl[1], contoh_tgl[2])
    cetak(format("{}-{}-{}", contoh_tgl[0], contoh_tgl[1], contoh_tgl[2]), "->", z, "->", balik[0], balik[1], balik[2])
}

cetak("== 4. hari dalam minggu & awal minggu Senin ==")
variabel z_hari_ini = hari_dari_civil(t["tahun"], t["bulan"], t["hari"])
cetak("z hari ini:", z_hari_ini, "=", teks_civil(z_hari_ini))
cetak("hari_dalam_minggu kita (0=Sen):", hari_dalam_minggu(z_hari_ini))
cetak("cross-check %u-1:", ke_bulat(format_tanggal("%u")) - 1, "| %w:", format_tanggal("%w"), "| t[hari_minggu]:", t["hari_minggu"])
variabel senin = awal_minggu_senin(z_hari_ini)
cetak("Senin pekan ini:", teks_civil(senin), "(0=Sen?", hari_dalam_minggu(senin) == 0, ")")
pastikan hari_dalam_minggu(senin) == 0, "hasil awal_minggu_senin harus Senin"

cetak("== 5. hari dalam seminggu untuk tanggal acak ==")
# 2026-11-04 adalah Rabu (berdasarkan lingkungan uji)
pastikan hari_dalam_minggu(hari_dari_civil(2026, 11, 4)) == 2, "2026-11-04 harus Rabu"
pastikan hari_dalam_minggu(hari_dari_civil(1970, 1, 1)) == 3, "1970-01-01 harus Kamis"
pastikan hari_dalam_minggu(hari_dari_civil(2000, 1, 1)) == 5, "2000-01-01 harus Sabtu"

cetak("== 6. rentang bulan untuk laporan ==")
fungsi awal_bulan(t, b) { kembalikan hari_dari_civil(t, b, 1) }
fungsi bulan_berikut(t, b) {
    jika b == 12 {
        kembalikan [t + 1, 1]
    }
    kembalikan [t, b + 1]
}
cetak("awal Nov 2026:", teks_civil(awal_bulan(2026, 11)), "-> awal Des:", teks_civil(awal_bulan(2026, 12)))
cetak("awal Des 2026 -> awal Jan 2027:", teks_civil(awal_bulan(bulan_berikut(2026, 12)[0], bulan_berikut(2026, 12)[1])))
variabel hari_feb_kabisat = awal_bulan(2024, 3) - awal_bulan(2024, 2)
cetak("Feb 2024 =", hari_feb_kabisat, "hari")
pastikan hari_feb_kabisat == 29, "Feb 2024 harus 29 hari"
variabel hari_feb_biasa = awal_bulan(2026, 3) - awal_bulan(2026, 2)
pastikan hari_feb_biasa == 28, "Feb 2026 harus 28 hari"

cetak("== 7. waktu() & henti sebagai penanda ==")
cetak("waktu():", waktu(), "| format_tanggal:", format_tanggal("%Y-%m-%d %H:%M:%S"))

cetak("SELESAI-POC-6")
