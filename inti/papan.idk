# inti/papan.idk — Data Papan Tulis dashboard (DESIGN §5.2).
# Dihitung ulang tiap render; nilai "—" bila belum ada datanya.

dari inti.format impor rupiah

fungsi ambil_papan(db) {
    variabel hasil = {"penjualan": "Rp 0", "piutang": "Rp 0", "laris": "—", "aktif": "0 barang"}
    coba {
        variabel hari = potong(format_tanggal("%Y-%m-%d %H:%M:%S"), 0, 10)
        variabel penjualan = db_ambil_satu(db, "SELECT COALESCE(SUM(total), 0) AS jml FROM transaksi WHERE status != 'batal' AND tanggal LIKE ?", [hari + "%"])
        variabel piutang = db_ambil_satu(db, "SELECT COALESCE(SUM(t.total - t.dibayar - COALESCE(p.bayar, 0)), 0) AS jml FROM transaksi t LEFT JOIN (SELECT transaksi_id, SUM(jumlah) AS bayar FROM pembayaran_bon GROUP BY transaksi_id) p ON p.transaksi_id = t.id WHERE t.status = 'bon'")
        variabel laris = db_ambil_semua(db, "SELECT d.nama_barang AS nama, SUM(d.jumlah) AS jml FROM detail_transaksi d JOIN transaksi t ON t.id = d.transaksi_id WHERE t.status != 'batal' GROUP BY d.barang_id ORDER BY jml DESC, d.nama_barang ASC LIMIT 1")
        variabel aktif = db_ambil_satu(db, "SELECT COUNT(*) AS jml FROM barang WHERE aktif = 1")
        hasil["penjualan"] = "Rp " + rupiah(penjualan["jml"])
        hasil["piutang"] = "Rp " + rupiah(piutang["jml"])
        jika panjang(laris) > 0 {
            hasil["laris"] = laris[0]["nama"]
        }
        hasil["aktif"] = ke_teks(aktif["jml"]) + " barang"
    } kecuali Galat {
    }
    kembalikan hasil
}
