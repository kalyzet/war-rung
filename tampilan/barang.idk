# tampilan/barang.idk — Layar modul Gudang: Kelola Barang (PRD §3.1, DESIGN §5.4).
# Layout teks-polos dulu, warna dibungkus sesudahnya (DESIGN §7.3).

impor tampilan.dasar
impor layanan.barang
dari inti.galat impor GalatValidasi, GalatData
dari model.barang impor status_teks
dari inti.format impor rupiah
dari teks impor teks_ulang, teks_pangkas, teks_berisi

fungsi sel_kiri(t, lebar, warna_kode) {
    kembalikan dasar.warna(dasar.kolom_kiri(t, lebar), warna_kode)
}

fungsi sel_kanan(t, lebar, warna_kode) {
    kembalikan dasar.warna(dasar.kolom_kanan(t, lebar), warna_kode)
}

fungsi rangkai_menu(pesan) {
    variabel b = "\n"
    b = b + "  " + dasar.warna(dasar.kolom_kiri("GUDANG — Kelola Barang", 34), dasar.TEBAL + dasar.TEKS) + "\n"
    b = b + "  " + dasar.divider(42) + "\n\n"
    variabel pilihan = [["1", "Daftar barang"], ["2", "Cari barang"], ["3", "Tambah barang"], ["4", "Ubah barang"], ["5", "Nonaktifkan barang"], ["6", "Hapus permanen"]]
    untuk i dalam rentang(panjang(pilihan)) {
        b = b + "  " + dasar.warna("[" + pilihan[i][0] + "]", dasar.NYALA) + " " + dasar.TEKS + pilihan[i][1] + dasar.RESET + "\n"
    }
    jika panjang(pesan) > 0 {
        b = b + "\n  " + dasar.warna("! " + pesan, dasar.MERAH) + "\n"
    }
    b = b + "\n  " + dasar.REDUP + "[0-6] Pilih | [Enter] Konfirmasi | [0] Kembali" + dasar.RESET + "\n\n"
    kembalikan b
}

fungsi rangkai_daftar(baruang) {
    jika panjang(baruang) == 0 {
        kembalikan ""
    }
    variabel h = "  " + sel_kanan("ID", 4, dasar.REDUP) + " " + sel_kiri("SKU", 10, dasar.REDUP) + " " + sel_kiri("Nama", 20, dasar.REDUP) + " " + sel_kanan("Harga", 10, dasar.REDUP) + " " + sel_kanan("Stok", 5, dasar.REDUP) + " " + sel_kanan("Min", 4, dasar.REDUP) + " " + sel_kiri("Status", 8, dasar.REDUP) + "\n"
    h = h + "  " + dasar.REDUP + teks_ulang("-", 67) + dasar.RESET + "\n"
    untuk brg dalam baruang {
        variabel ws = dasar.TEKS
        jika brg["stok"] <= brg["stok_minimum"] {
            ws = dasar.MERAH
        }
        variabel wstatus = dasar.MERAH
        jika brg["aktif"] {
            wstatus = dasar.HIJAU
        }
        h = h + "  " + sel_kanan(ke_teks(brg["id"]), 4, dasar.TEKS) + " " + sel_kiri(brg["sku"], 10, dasar.TEKS) + " " + sel_kiri(brg["nama"], 20, dasar.TEKS) + " " + sel_kanan(rupiah(brg["harga_jual"]), 10, dasar.TEKS) + " " + sel_kanan(ke_teks(brg["stok"]), 5, ws) + " " + sel_kanan(ke_teks(brg["stok_minimum"]), 4, dasar.TEKS) + " " + sel_kiri(status_teks(brg), 8, wstatus) + "\n"
    }
    kembalikan h
}

fungsi rangkai_detail(b) {
    variabel h = "\n  " + dasar.warna(dasar.kolom_kiri("DETAIL BARANG", 34), dasar.TEBAL + dasar.TEKS) + "\n"
    h = h + "  " + dasar.divider(42) + "\n"
    variabel label = dasar.REDUP
    h = h + "  " + label + dasar.kolom_kiri("ID", 14) + dasar.RESET + ": " + ke_teks(b["id"]) + "\n"
    h = h + "  " + label + dasar.kolom_kiri("SKU", 14) + dasar.RESET + ": " + b["sku"] + "\n"
    h = h + "  " + label + dasar.kolom_kiri("Nama", 14) + dasar.RESET + ": " + b["nama"] + "\n"
    h = h + "  " + label + dasar.kolom_kiri("Harga beli", 14) + dasar.RESET + ": Rp " + rupiah(b["harga_beli"]) + "\n"
    h = h + "  " + label + dasar.kolom_kiri("Harga jual", 14) + dasar.RESET + ": Rp " + rupiah(b["harga_jual"]) + "\n"
    variabel ws = dasar.TEKS
    jika b["stok"] <= b["stok_minimum"] {
        ws = dasar.MERAH
    }
    h = h + "  " + label + dasar.kolom_kiri("Stok", 14) + dasar.RESET + ": " + dasar.warna(ke_teks(b["stok"]), ws) + "  (minimum " + ke_teks(b["stok_minimum"]) + ")\n"
    variabel wstatus = dasar.MERAH
    jika b["aktif"] {
        wstatus = dasar.HIJAU
    }
    h = h + "  " + label + dasar.kolom_kiri("Status", 14) + dasar.RESET + ": " + dasar.warna(status_teks(b), wstatus) + "\n"
    h = h + "\n"
    kembalikan h
}

fungsi baca_isian(petunjuk) {
    variabel j = ""
    coba {
        j = input(petunjuk)
    } kecuali Galat {
        kembalikan kosong
    }
    jika j == kosong {
        kembalikan kosong
    }
    kembalikan teks_pangkas(j)
}

fungsi baca_angka(petunjuk) {
    variabel j = baca_isian(petunjuk)
    jika j == kosong {
        kembalikan kosong
    }
    jika j == "" {
        kembalikan ""
    }
    jika teks_berisi(j, ".") atau teks_berisi(j, ",") {
        naikkan GalatValidasi("Angka ditulis tanpa titik atau koma ya, Bos.")
    }
    coba {
        kembalikan ke_bulat(ke_angka(j))
    } kecuali Galat {
        naikkan GalatValidasi("Itu bukan angka, Bos.")
    }
}

fungsi konversi_id(teks) {
    coba {
        kembalikan ke_bulat(ke_angka(teks))
    } kecuali Galat {
        naikkan GalatValidasi("ID harus angka ya, Bos.")
    }
}

fungsi batal() {
    dasar.dialog("Oke, dibatalkan ya, Bos.")
    kembalikan 0
}

fungsi tampilkan_daftar(db) {
    variabel barangg = barang.daftar(db)
    variabel blok = "\n  " + dasar.warna(dasar.kolom_kiri("DAFTAR BARANG", 34), dasar.TEBAL + dasar.TEKS) + "\n"
    blok = blok + "  " + dasar.divider(42) + "\n"
    jika panjang(barangg) == 0 {
        blok = blok + "\n  " + dasar.warna("Belum ada barang di gudang, Bos. Ketik [3] untuk tambah baru.", dasar.REDUP) + "\n"
    } selain {
        blok = blok + rangkai_daftar(barangg)
        blok = blok + "\n  " + dasar.REDUP + "(" + ke_teks(panjang(barangg)) + " barang; merah = stok di/bawah minimum)" + dasar.RESET + "\n"
    }
    blok = blok + "\n  " + dasar.REDUP + "[Enter] kembali | atau ketik ID untuk lihat detail" + dasar.RESET + "\n"
    dasar.bersihkan_layar()
    cetak(blok, akhir="")
    variabel j = baca_isian("  ID detail : ")
    jika j == kosong atau j == "" {
        kembalikan 0
    }
    variabel b = barang.detail(db, konversi_id(j))
    dasar.bersihkan_layar()
    cetak(rangkai_detail(b), akhir="")
    dasar.dialog("Enter untuk kembali, Bos.")
    kembalikan 0
}

fungsi tampilkan_cari(db) {
    dasar.bersihkan_layar()
    cetak("\n  " + dasar.warna(dasar.kolom_kiri("CARI BARANG", 34), dasar.TEBAL + dasar.TEKS) + "\n", akhir="")
    cetak("  " + dasar.divider(42) + "\n\n", akhir="")
    variabel kata = baca_isian("  Ketik nama atau SKU : ")
    jika kata == kosong atau kata == "" {
        kembalikan batal()
    }
    variabel hasil = barang.cari(db, kata)
    variabel blok = "\n  " + dasar.warna(dasar.kolom_kiri("HASIL CARI: " + kata, 34), dasar.TEBAL + dasar.TEKS) + "\n"
    blok = blok + "  " + dasar.divider(42) + "\n"
    jika panjang(hasil) == 0 {
        blok = blok + "\n  " + dasar.warna("Tidak ketemu, Bos. Coba kata lain.", dasar.REDUP) + "\n"
    } selain {
        blok = blok + rangkai_daftar(hasil)
        blok = blok + "\n  " + dasar.REDUP + "(" + ke_teks(panjang(hasil)) + " barang ketemu)" + dasar.RESET + "\n"
    }
    dasar.bersihkan_layar()
    cetak(blok, akhir="")
    dasar.dialog("Enter untuk kembali, Bos.")
    kembalikan 0
}

fungsi tampilkan_tambah(db) {
    dasar.bersihkan_layar()
    cetak("\n  " + dasar.warna(dasar.kolom_kiri("TAMBAH BARANG", 34), dasar.TEBAL + dasar.TEKS) + "\n", akhir="")
    cetak("  " + dasar.divider(42) + "\n\n", akhir="")
    cetak("  " + dasar.REDUP + "Isi kosong = batalkan" + dasar.RESET + "\n\n", akhir="")
    variabel sku = baca_isian("  SKU             : ")
    jika sku == kosong atau sku == "" {
        kembalikan batal()
    }
    variabel nama = baca_isian("  Nama barang     : ")
    jika nama == kosong atau nama == "" {
        kembalikan batal()
    }
    variabel hb = baca_angka("  Harga beli (Rp) : ")
    jika hb == kosong atau hb == "" {
        kembalikan batal()
    }
    variabel hj = baca_angka("  Harga jual (Rp) : ")
    jika hj == kosong atau hj == "" {
        kembalikan batal()
    }
    variabel stok = baca_angka("  Stok awal       : ")
    jika stok == kosong atau stok == "" {
        kembalikan batal()
    }
    variabel minimum = baca_angka("  Stok minimum    : ")
    jika minimum == kosong atau minimum == "" {
        kembalikan batal()
    }
    variabel id = barang.tambah(db, {"sku": sku, "nama": nama, "harga_beli": hb, "harga_jual": hj, "stok": stok, "stok_minimum": minimum})
    dasar.dialog("'" + nama + "' masuk gudang dengan ID " + ke_teks(id) + ", Bos!")
    kembalikan 0
}

fungsi tampilkan_ubah(db) {
    dasar.bersihkan_layar()
    cetak("\n  " + dasar.warna(dasar.kolom_kiri("UBAH BARANG", 34), dasar.TEBAL + dasar.TEKS) + "\n", akhir="")
    cetak("  " + dasar.divider(42) + "\n\n", akhir="")
    variabel jawab = baca_isian("  ID barang (0 = batal) : ")
    jika jawab == kosong atau jawab == "" {
        kembalikan batal()
    }
    variabel id = konversi_id(jawab)
    jika id == 0 {
        kembalikan batal()
    }
    variabel lama = barang.detail(db, id)
    cetak("  " + dasar.REDUP + "Enter = pakai nilai lama" + dasar.RESET + "\n\n", akhir="")
    variabel sku = baca_isian("  SKU  [" + lama["sku"] + "] : ")
    jika sku == kosong {
        kembalikan batal()
    }
    jika sku == "" {
        sku = lama["sku"]
    }
    variabel nama = baca_isian("  Nama [" + lama["nama"] + "] : ")
    jika nama == kosong {
        kembalikan batal()
    }
    jika nama == "" {
        nama = lama["nama"]
    }
    variabel hb = baca_angka("  Harga beli (Rp) [" + rupiah(lama["harga_beli"]) + "] : ")
    jika hb == kosong {
        kembalikan batal()
    }
    jika hb == "" {
        hb = lama["harga_beli"]
    }
    variabel hj = baca_angka("  Harga jual (Rp) [" + rupiah(lama["harga_jual"]) + "] : ")
    jika hj == kosong {
        kembalikan batal()
    }
    jika hj == "" {
        hj = lama["harga_jual"]
    }
    variabel stok = baca_angka("  Stok [" + ke_teks(lama["stok"]) + "] : ")
    jika stok == kosong {
        kembalikan batal()
    }
    jika stok == "" {
        stok = lama["stok"]
    }
    variabel minimum = baca_angka("  Stok minimum [" + ke_teks(lama["stok_minimum"]) + "] : ")
    jika minimum == kosong {
        kembalikan batal()
    }
    jika minimum == "" {
        minimum = lama["stok_minimum"]
    }
    barang.ubah(db, id, {"sku": sku, "nama": nama, "harga_beli": hb, "harga_jual": hj, "stok": stok, "stok_minimum": minimum})
    dasar.dialog("Perubahan '" + nama + "' tersimpan, Bos!")
    kembalikan 0
}

fungsi tampilkan_nonaktif(db) {
    dasar.bersihkan_layar()
    cetak("\n  " + dasar.warna(dasar.kolom_kiri("NONAKTIFKAN BARANG", 34), dasar.TEBAL + dasar.TEKS) + "\n", akhir="")
    cetak("  " + dasar.divider(42) + "\n\n", akhir="")
    variabel jawab = baca_isian("  ID barang (kosong = batal) : ")
    jika jawab == kosong atau jawab == "" {
        kembalikan batal()
    }
    variabel b = barang.detail(db, konversi_id(jawab))
    variabel jwb = baca_isian("  Nonaktifkan '" + b["nama"] + "'? [y/t] : ")
    jika jwb == kosong atau jwb == "" {
        kembalikan batal()
    }
    jika huruf_besar(jwb) != "Y" {
        dasar.dialog("Tidak jadi ya, Bos.")
        kembalikan 0
    }
    barang.nonaktifkan(db, b["id"])
    dasar.dialog("'" + b["nama"] + "' dinonaktifkan, Bos.")
    kembalikan 0
}

fungsi tampilkan_hapus(db) {
    dasar.bersihkan_layar()
    cetak("\n  " + dasar.warna(dasar.kolom_kiri("HAPUS PERMANEN", 34), dasar.TEBAL + dasar.TEKS) + "\n", akhir="")
    cetak("  " + dasar.divider(42) + "\n\n", akhir="")
    variabel jawab = baca_isian("  ID barang (kosong = batal) : ")
    jika jawab == kosong atau jawab == "" {
        kembalikan batal()
    }
    variabel b = barang.detail(db, konversi_id(jawab))
    variabel jwb = baca_isian("  Hapus PERMANEN '" + b["nama"] + "'? [y/t] : ")
    jika jwb == kosong atau jwb == "" {
        kembalikan batal()
    }
    jika huruf_besar(jwb) != "Y" {
        dasar.dialog("Tidak jadi ya, Bos.")
        kembalikan 0
    }
    barang.hapus_permanen(db, b["id"])
    dasar.dialog("'" + b["nama"] + "' dihapus dari gudang, Bos!")
    kembalikan 0
}

fungsi jalankan(db) {
    variabel berjalan = benar
    variabel pesan = ""
    selagi berjalan {
        dasar.bersihkan_layar()
        cetak(rangkai_menu(pesan), akhir="")
        variabel p = dasar.baca_pilihan(6)
        pesan = ""
        jika p == -2 {
            berjalan = salah
        } jika_lain p == -3 {
            pesan = ""
        } jika_lain p == -1 {
            pesan = "Ketik nomor menu dulu, Bos (0-6)."
        } jika_lain p == 0 {
            berjalan = salah
        } selain {
            coba {
                jika p == 1 {
                    tampilkan_daftar(db)
                } jika_lain p == 2 {
                    tampilkan_cari(db)
                } jika_lain p == 3 {
                    tampilkan_tambah(db)
                } jika_lain p == 4 {
                    tampilkan_ubah(db)
                } jika_lain p == 5 {
                    tampilkan_nonaktif(db)
                } jika_lain p == 6 {
                    tampilkan_hapus(db)
                }
            } kecuali GalatValidasi sebagai e {
                dasar.dialog(e.pesan)
            } kecuali GalatData sebagai e {
                dasar.dialog(e.pesan)
            }
        }
    }
    kembalikan 0
}
